{
  "name": "fulviocanducci/opencnpj",
  "description": "Consulta CNPJs via API com retorno estruturado em objetos PHP",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Canducci\\OpenCnpj\\": "src/Canducci/OpenCnpj/"
    },
    "files": [
      "src/Canducci/OpenCnpj/Helpers/opencnpj_helper.php"
    ]
  },
  "scripts": {
    "test": "phpunit ./tests --testdox"
  },
  "authors": [
    {
      "name": "Fulvio Cezar Canducci Dias",
      "email": "fulviocanducci@hotmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpseclib/mcrypt_compat": "^2.0",
    "orchestra/testbench": "9.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Canducci\\OpenCnpj\\Providers\\OpenCnpjServiceProvider"
      ]
    }
  }
}
